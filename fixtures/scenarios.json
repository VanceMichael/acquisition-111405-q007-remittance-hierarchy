[
  {
    "name": "levels",
    "routes": [
      {
        "path": "/advice",
        "body": {
          "envelopes": [
            {
              "sender": "s",
              "control": "c1",
              "href": "/envelope/1"
            }
          ]
        },
        "status": 200,
        "method": "GET"
      },
      {
        "path": "/envelope/1",
        "body": {
          "paymentId": "p1",
          "currency": "CNY",
          "paid": "89.90",
          "providerAdjustments": [
            {
              "group": "P",
              "reason": "fee",
              "amount": "0.10"
            }
          ],
          "claims": [
            {
              "claimId": "cA",
              "submitted": "100.00",
              "paid": "90.00",
              "adjustments": [
                {
                  "group": "C",
                  "reason": "contract",
                  "amount": "10.00"
                }
              ],
              "lines": [
                {
                  "lineId": "l1",
                  "charge": "100.00",
                  "paid": "90.00",
                  "adjustments": []
                }
              ]
            }
          ]
        },
        "status": 200,
        "method": "GET"
      }
    ],
    "expected": [
      {
        "paymentKey": "s/p1",
        "claimKey": "s/cA",
        "lineId": "l1",
        "paid": "90.00"
      }
    ],
    "forbidden": []
  },
