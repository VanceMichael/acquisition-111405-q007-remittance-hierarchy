  {
    "name": "multi-claim-jpy",
    "runs": 2,
    "requiredRequests": ["GET /advice", "GET /envelope/j1"],
    "maximumRequests": 4,
    "routes": [
      {
        "path": "/advice",
        "body": {
          "envelopes": [
            {
              "sender": "s",
              "control": "cj",
              "href": "/envelope/j1"
            }
          ]
        },
        "status": 200,
        "method": "GET"
      },
      {
        "path": "/envelope/j1",
        "body": {
          "paymentId": "pj",
          "currency": "JPY",
          "paid": "1497",
          "providerAdjustments": [
            {
              "group": "P",
              "reason": "fee",
              "amount": "3"
            }
          ],
          "claims": [
            {
              "claimId": "c1",
              "submitted": "1200",
              "paid": "1000",
              "adjustments": [
                {
                  "group": "C",
                  "reason": "contract",
                  "amount": "200"
                }
              ],
              "lines": [
                {
                  "lineId": "l1",
                  "charge": "700",
                  "paid": "650",
                  "adjustments": [
                    {
                      "group": "C",
                      "reason": "line-contract",
                      "amount": "50"
                    }
                  ]
                },
                {
                  "lineId": "l2",
                  "charge": "500",
                  "paid": "350",
                  "adjustments": [
                    {
                      "group": "C",
                      "reason": "line-contract",
                      "amount": "150"
                    }
                  ]
                }
              ]
            },
            {
              "claimId": "c2",
              "submitted": "500",
              "paid": "500",
              "adjustments": [],
              "lines": []
            }
          ]
        },
        "status": 200,
        "method": "GET"
      }
    ],
    "expected": [
      {
        "paymentKey": "s/pj",
        "claimKey": "s/c1",
        "lineId": "l1",
        "paid": "650",
        "balanceStatus": "balanced"
      },
      {
        "paymentKey": "s/pj",
        "claimKey": "s/c2",
        "balanceStatus": "balanced"
      },
      {
        "paymentKey": "s/pj",
        "level": "payment",
        "paid": "1497",
        "balanceStatus": "balanced"
      }
    ],
    "forbidden": [
      {
        "adjustments": [
          {
            "group": "P",
            "reason": "fee",
            "amount": "3"
          }
        ]
      },
      {
        "claimKey": "s/c2",
        "lineId": "l1"
      }
    ]
  },
